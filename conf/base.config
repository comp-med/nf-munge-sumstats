// Process Runtime Configuration --------------------------------------------

process {
  cpus   = { 1      * task.attempt }
  memory = { 6.GB   * task.attempt }
  time   = { 4.h    * task.attempt }

  errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
  maxRetries    = 3
  maxErrors     = '-1'
}

// Process Configuration ------------------------------------------------------

process {
    withLabel: rProcess {
       cpus          = { 8 }
       memory        = { 12.GB }
       time          = { 1.h }
       errorStrategy = 'terminate'
       maxRetries    = 0
    }
    withName: "GET_INPUT_COL_HEADERS" {
        cpus          = { 8 * task.attempt }
        memory        = { 12.GB * task.attempt }
        time          = { 1.h * task.attempt }
        maxRetries    = 2
    } 
    withName: "SAVE_PARQUET|LIFTOVER_SUMSTATS" {
        cpus          = { 8 * task.attempt }
        memory        = { 12.GB * task.attempt }
        time          = { 1.h * task.attempt }
        maxRetries    = 2
    }
    withName: "GET_GENOME_BUILD|FORMAT_SUMSTATS" {
        cpus          = { 16 * task.attempt }
        memory        = { 12.GB * task.attempt }
        time          = { 1.h * task.attempt }
        maxRetries    = 2
    }
}
