// Process Runtime Configuration --------------------------------------------

process {
  cpus   = { 1      * task.attempt }
  memory = { 6.GB   * task.attempt }
  time   = { 4.h    * task.attempt }

  errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
  maxRetries    = 3
  maxErrors     = '-1'
}

// Process Configuration ------------------------------------------------------

process {
    withLabel: rProcess {
       cpus          = { 8 }
       memory        = { 16.GB }
       time          = { 1.h }
       errorStrategy = 'terminate'
       maxRetries    = 0
    }
    withName: "SETUP_MUNGING:GET_INPUT_COL_HEADERS" {
        cpus          = { 8 * task.attempt }
        memory        = { 16.GB * task.attempt }
        time          = { 1.h * task.attempt }
        maxRetries    = 2
    } 
    withName: "MUNGE_SUMSTATS:SAVE_PARQUET|MUNGE_SUMSTATS:LIFTOVER_SUMSTATS" {
        cpus          = { 8 * task.attempt }
        memory        = { 16.GB * task.attempt }
        time          = { 1.h * task.attempt }
        maxRetries    = 2
    }
    withName: "MUNGE_SUMSTATS:GET_GENOME_BUILD|MUNGE_SUMSTATS:FORMAT_SUMSTATS" {
        cpus          = { 16 * task.attempt }
        memory        = { 32.GB * task.attempt }
        time          = { 2.h * task.attempt }
        maxRetries    = 2
    }
}
